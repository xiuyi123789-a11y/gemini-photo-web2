{
  "name": "量子跃迁ai修图工作室",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:vite": "vite",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "changelog": "node scripts/update-changelog.js",
    "build": "vite build",
    "preview": "vite preview",
    "release": "node scripts/update-changelog.js && git add src/data/changelog.json && git commit -m \"chore: update changelog\" && git push origin main",
    "create-user": "node server/create-user.js",
    "test": "node --import ./tests/block-external-fetch.js --test tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "export:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fs-extra": "^11.3.2",
    "lucide-react": "^0.554.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "replicate": "^1.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.17",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pg-mem": "^3.0.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

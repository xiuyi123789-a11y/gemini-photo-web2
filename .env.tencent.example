# Copy to .env.tencent on the server only. Never commit actual credentials.
# Domain only, without https:// or paths. Point its A record to your Tencent server.
DOMAIN=studio.example.com
# Generate a new password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional shared billing token. Leave blank if every user supplies their own token.
REPLICATE_API_TOKEN=
# Replication v2: kill switch for NEW jobs. Queries/cancel/review remain available.
REPLICATION_ENABLED=true
# Keep multi-candidate and 4K disabled until controlled real-image acceptance.
REPLICATION_ADVANCED_OUTPUTS=false
REPLICATION_TIMEOUT_SECONDS=300
REPLICATION_RETENTION_DAYS=30
REPLICATION_MAX_REFERENCES=6
